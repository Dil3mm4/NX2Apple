diff --git a/dm/host/hle_time.c b/dm/host/hle_time.c
index f88d64b..634fa7d 100644
--- a/dm/host/hle_time.c
+++ b/dm/host/hle_time.c
@@ -2,6 +2,7 @@
 // Layout follows the public Horizon ABI: PosixTime = int64 seconds; CalendarTime = {s16 year, s8 month/day/hour/minute/second};
 // CalendarAdditionalInfo = {u32 day of week, u32 day of year, char time zone name[8], u32 DST, s32 UTC offset in seconds}.
 #include "hle.h"
+#include <errno.h>
 #include <stdatomic.h>
 #include <time.h>
 
@@ -15,6 +16,67 @@ static int64_t fixed_time(void) {
                    if (v >= 0) LOG("DM_FIXED_TIME=%lld: the user clock returns a fixed value", (long long)v); }
     return v;
 }
+
+// A game's wall clock can be moved without changing its steady clock or touching the Mac's clock.
+// The launcher writes these per-title env.txt values:
+// DM_VCLOCK_MODE=off|restart|continue, DM_VCLOCK_START=<Unix seconds>, DM_VCLOCK_ANCHOR=<Unix seconds>.
+// Restart starts at START on each launch. Continue adds real-world time since ANCHOR to START, including time spent closed.
+// Once launched, both modes advance with CLOCK_MONOTONIC (not the system wall clock), so an OS clock adjustment cannot jump gameplay.
+typedef struct { int mode, explicit_off; int64_t base; uint64_t mono_ns; } dm_virtual_clock_state;
+static dm_virtual_clock_state g_vclock;
+static pthread_once_t g_vclock_once = PTHREAD_ONCE_INIT;
+static int parse_vclock_epoch(const char *s, int64_t *out) {
+    if (!s || !*s) return 0;
+    errno = 0;
+    char *end; long long value = strtoll(s, &end, 10);
+    if (errno || end == s || *end || value < 0 || value > 253402300799LL) return 0; // 1970..9999
+    *out = value;
+    return 1;
+}
+static void init_vclock(void) {
+    const char *mode = getenv("DM_VCLOCK_MODE");
+    if (!mode || !*mode) return;  // legacy DM_FIXED_TIME still works
+    g_vclock.explicit_off = 1;   // an explicit Off overrides a packed DM_FIXED_TIME
+    if (!strcmp(mode, "off")) return;
+    int kind = !strcmp(mode, "restart") ? 1 : !strcmp(mode, "continue") ? 2 : 0;
+    int64_t start, anchor = 0;
+    if (!kind || !parse_vclock_epoch(getenv("DM_VCLOCK_START"), &start) ||
+        (kind == 2 && !parse_vclock_epoch(getenv("DM_VCLOCK_ANCHOR"), &anchor))) {
+        LOG("[RED] time: invalid virtual clock configuration; using real time");
+        return;
+    }
+    int64_t elapsed = 0;
+    if (kind == 2) {
+        elapsed = (int64_t)time(NULL) - anchor;
+        if (elapsed < 0) elapsed = 0;  // do not run backwards after a host clock adjustment
+    }
+    g_vclock.base = start + elapsed;
+    g_vclock.mono_ns = clock_gettime_nsec_np(CLOCK_MONOTONIC);
+    g_vclock.mode = kind;
+    LOG("time: simulated clock %s, starting at Unix %lld", kind == 1 ? "restart" : "continue",
+        (long long)g_vclock.base);
+}
+static int vclock_read(int64_t *sec, int64_t *nsec) {
+    pthread_once(&g_vclock_once, init_vclock);
+    if (g_vclock.mode) {
+        uint64_t now = clock_gettime_nsec_np(CLOCK_MONOTONIC);
+        uint64_t elapsed = now >= g_vclock.mono_ns ? now - g_vclock.mono_ns : 0;
+        *sec = g_vclock.base + (int64_t)(elapsed / 1000000000ull);
+        *nsec = (int64_t)(elapsed % 1000000000ull);
+        return 1;
+    }
+    if (g_vclock.explicit_off) {
+        struct timespec now; clock_gettime(CLOCK_REALTIME, &now);
+        *sec = now.tv_sec; *nsec = now.tv_nsec;
+        return 1;
+    }
+    return 0;
+}
+static int vclock_context_is_stable(void) {
+    pthread_once(&g_vclock_once, init_vclock);
+    return g_vclock.mode || (!g_vclock.explicit_off && fixed_time() >= 0);
+}
+
