diff --git a/dm/host/tests/t_vclock.c b/dm/host/tests/t_vclock.c
new file mode 100644
index 0000000..9cb6f95
--- /dev/null
+++ b/dm/host/tests/t_vclock.c
@@ -0,0 +1,50 @@
+// Each invocation checks one clock mode: pthread_once deliberately reads the env only once per game process.
+#include "../hle_time.c"
+
+// hle_time.c also contains a guest-symbol lookup in an unrelated SDK hook.
+void *guest_sym(const char *name) { (void)name; return NULL; }
+
+uint64_t guest_ns(void) { return clock_gettime_nsec_np(CLOCK_MONOTONIC); }
+static int failures;
+#define CHECK(c, what) do { if (!(c)) { failures++; fprintf(stderr, "FAIL: %s\n", what); } } while (0)
+
+int main(int argc, char **argv) {
+    if (argc != 2) return 2;
+    const char *mode = argv[1];
+    const int64_t start = 1700000000;
+    int64_t now = 0, ts[2] = {0};
+    setenv("DM_VCLOCK_START", "1700000000", 1);
+    if (!strcmp(mode, "continue")) {
+        char anchor[32];
+        snprintf(anchor, sizeof anchor, "%lld", (long long)time(NULL) - 3600);
+        setenv("DM_VCLOCK_ANCHOR", anchor, 1);
+        setenv("DM_VCLOCK_MODE", "continue", 1);
+        CHECK(h_time_GetCurrentTime(&now) == RES_OK, "continue clock reads");
+        CHECK(now >= start + 3599 && now <= start + 3601, "continue includes an hour spent closed");
+    } else if (!strcmp(mode, "restart")) {
+        setenv("DM_VCLOCK_MODE", "restart", 1);
+        CHECK(h_time_GetCurrentTime(&now) == RES_OK, "restart clock reads");
+        CHECK(now == start, "restart begins at chosen date");
+    } else if (!strcmp(mode, "off")) {
+        setenv("DM_FIXED_TIME", "1700000000", 1);
+        setenv("DM_VCLOCK_MODE", "off", 1);
+        CHECK(h_time_GetCurrentTime(&now) == RES_OK, "off clock reads");
+        CHECK(llabs(now - (int64_t)time(NULL)) <= 1, "explicit Off overrides legacy frozen time");
+        CHECK(g_vclock.mode == 0, "off does not create a virtual clock");
+    } else if (!strcmp(mode, "legacy")) {
+        setenv("DM_FIXED_TIME", "1700000000", 1);
+        CHECK(h_time_GetCurrentTime(&now) == RES_OK && now == start, "old fixed time remains supported");
+    } else return 2;
+
+    CHECK(h_time_timespec(ts) == 0, "timespec reports a time");
+    CHECK(llabs(ts[0] - now) <= 1, "SDK real-time path agrees with user clock");
+    if (g_vclock.mode) {
+        // Inject 5 seconds of monotonic progress, with no change to the host wall clock.
+        g_vclock.mono_ns -= 5000000000ull;
+        int64_t later = 0;
+        h_time_GetCurrentTime(&later);
+        CHECK(later >= now + 5 && later <= now + 6, "simulated time advances with monotonic elapsed time");
+    }
+    printf("virtual clock %s: %d failures\n", mode, failures);
+    return failures != 0;
+}
